<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/layoutCenterBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo Container with soft shadow and white background -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSplashLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/logo_sekolah"
                android:scaleType="fitCenter"
                android:contentDescription="Logo Sekolah" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Welcome Text -->
        <TextView
            android:id="@+id/tvSplashWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Selamat Datang di E-Ujian"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- School Name -->
        <TextView
            android:id="@+id/tvSplashSchoolName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="MTS ROUDHOTUT THOWALIB"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- School Subtitle / Tagline -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:text="Aplikasi Ujian Kiosk &amp; Berbasis Komputer" />
    </LinearLayout>

    <!-- Bottom Loading Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/splashProgress"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/primary"
            app:trackColor="#E2E8F0"
            app:trackCornerRadius="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Memuat Sistem Ujian..."
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>
